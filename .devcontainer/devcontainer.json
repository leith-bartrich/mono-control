{
  "name": "mono-control",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "remoteUser": "codespace",

  // Install uv (Astral's Python package manager) via the official installer.
  // There is no first-party dev container feature for uv, so we use the
  // upstream install script and expose it on PATH for the vscode user.
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh",
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:PATH}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropics.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.languageServer": "Pylance",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.python",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  }
}
