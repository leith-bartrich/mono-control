{
  "name": "mono-control",

  // The container is defined by Docker Compose: the base docker-compose.yml holds
  // the image, sandbox sentinel, and run context (the pure built tool), and is
  // what the headless `mproj` shim runs alone. This file is just the VS Code
  // attachment over that service.
  //
  // The array layers a dev-time-only overlay on top of the base; the first file
  // is primary. The overlay adds everything specific to interactive dev — live
  // source + sibling workspace bind mounts + the Claude Code volume — none of
  // which the headless path gets.
  "dockerComposeFile": ["docker-compose.yml", "docker-compose.devcontainer.yml"],
  "service": "mono-control",
  "workspaceFolder": "/workspaces/mono-control",
  "remoteUser": "codespace",

  // Dev-only provisioning (the headless path does not run lifecycle hooks). The
  // image already provides git, uv, the git safe.directory config, AND a baked
  // mono-control environment on PATH (see the Dockerfile) — so this only needs to:
  //   1. chown the freshly-created .claude named volume (mounts root-owned) to
  //      codespace, so Claude Code can write to it — idempotent once owned;
  //   2. `uv sync --locked` — create the project .venv (editable install + dev
  //      deps such as pytest) that VS Code activates in terminals and points its
  //      interpreter at. `--locked` installs exactly the pinned, hash-verified
  //      versions in uv.lock and fails if the lock is stale, rather than silently
  //      re-resolving.
  // There is deliberately no `uv tool install` step: the image's baked venv already
  // exposes `mono-control` on PATH via an EDITABLE install pointing at
  // /workspaces/mono-control — which in dev mode is the live bind mount — so a
  // second install would be both redundant and an unpinned resolve.
  // This step builds the package, whose in-tree build backend (_build/gate.py)
  // requires the container marker file baked into the image
  // (/etc/mono-control-container) — present here, absent on the host, so a host
  // build fails fast.
  "postCreateCommand": "sudo chown -R codespace:codespace $HOME/.claude && uv sync --locked",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropics.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.languageServer": "Pylance",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.python",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  }
}
