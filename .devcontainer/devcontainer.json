{
  "name": "mono-control",

  // The container is defined by Docker Compose: the base docker-compose.yml holds
  // the image, sandbox sentinel, and run context (the pure built tool), and is
  // what the headless `mproj` shim runs alone. This file is just the VS Code
  // attachment over that service.
  //
  // The array layers a dev-time-only overlay on top of the base; the first file
  // is primary. The overlay adds everything specific to interactive dev — live
  // source + sibling workspace bind mounts + the Claude Code volume — none of
  // which the headless path gets.
  "dockerComposeFile": ["docker-compose.yml", "docker-compose.devcontainer.yml"],
  "service": "mono-control",
  "workspaceFolder": "/workspaces/mono-control",
  "remoteUser": "codespace",

  // Dev-only provisioning (the headless path does not run lifecycle hooks). The
  // image already provides git, uv, and the git safe.directory config, so this
  // only needs to:
  //   1. chown the freshly-created .claude named volume (mounts root-owned) to
  //      codespace, so Claude Code can write to it — idempotent once owned;
  //   2. `uv sync` — create the project .venv (editable install + dev deps such
  //      as pytest) that VS Code activates in terminals;
  //   3. `uv tool install` — also expose `mono-control` as a standalone command
  //      on PATH (~/.local/bin), independent of venv activation.
  // Both uv steps build the package, whose in-tree build backend (_build/gate.py)
  // requires the container marker file baked into the image (/etc/mono-control-container)
  // — present here, absent on the host, so a host build fails fast.
  "postCreateCommand": "sudo chown -R codespace:codespace $HOME/.claude && uv sync && uv tool install --force --editable .",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropics.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.languageServer": "Pylance",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.python",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  }
}
